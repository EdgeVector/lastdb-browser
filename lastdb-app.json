{
  "app_id": "lastdb-browser",
  "version": "0.1.0",
  "source": "https://github.com/EdgeVector/lastdb-browser.git",
  "metadata": {
    "display_name": "lastdb-browser",
    "description": "Interactive data browser for a local LastDB node: schemas -> keys -> records -> fields.",
    "homepage_url": "https://github.com/EdgeVector/lastdb-browser"
  },
  "run": {
    "runtime": "command",
    "entrypoint": "bin/lastdb-browser"
  },
  "schemas": [],
  "install": {
    "prepare": [
      {
        "argv": [
          "npm",
          "ci"
        ],
        "timeout_s": 300
      },
      {
        "argv": [
          "npm",
          "run",
          "build"
        ],
        "timeout_s": 120
      }
    ],
    "probe": [
      {
        "argv": [
          "./bin/lastdb-browser",
          "--help"
        ],
        "timeout_s": 30
      }
    ],
    "links": [
      {
        "source": "bin/lastdb-browser",
        "command": "lastdb-browser"
      }
    ],
    "post_install": [],
    "requires": []
  }
}
